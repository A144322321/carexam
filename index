const DB = {
  db: null, ok: false, mem: {},
  open() {
    return new Promise(res => {
      try {
        const r = indexedDB.open('gy-inspect', 1);
        r.onupgradeneeded = () => r.result.createObjectStore('kv');
        r.onsuccess = () => { this.db = r.result; this.ok = true; res(true); };
        r.onerror = () => res(false); r.onblocked = () => res(false);
      } catch (e) { res(false); }
    });
  },
  get(k) {
    if (!this.ok) return Promise.resolve(this.mem[k]);
    return new Promise(res => { try { const q = this.db.transaction('kv').objectStore('kv').get(k); q.onsuccess = () => res(q.result); q.onerror = () => res(undefined); } catch (e) { res(undefined); } });
  },
  set(k, v) {
    this.mem[k] = v; if (!this.ok) return Promise.resolve();
    return new Promise(res => { try { const t = this.db.transaction('kv', 'readwrite'); t.objectStore('kv').put(v, k); t.oncomplete = () => res(); t.onerror = () => res(); t.onabort = () => { toast('儲存空間不足，資料可能未保存', true); res(); }; } catch (e) { res(); } });
  },
  del(k) {
    delete this.mem[k]; if (!this.ok) return Promise.resolve();
    return new Promise(res => { try { const t = this.db.transaction('kv', 'readwrite'); t.objectStore('kv').delete(k); t.oncomplete = () => res(); t.onerror = () => res(); } catch (e) { res(); } });
  },
  keys() {
    if (!this.ok) return Promise.resolve(Object.keys(this.mem));
    return new Promise(res => { const q = this.db.transaction('kv').objectStore('kv').getAllKeys(); q.onsuccess = () => res(q.result); q.onerror = () => res([]); });
  }
};
