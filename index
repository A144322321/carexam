<!DOCTYPE html>
<html lang="zh-Hant" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>車輛查定系統</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#14202b;--ink2:#3b4a58;--mute:#6c7b88;--line:#d9e0e6;--line2:#c3ccd4;
  --paper:#f2f4f6;--panel:#fff;--blue:#1746c9;--blue-d:#0f34a0;--blue-s:#e8eefc;
  --amber:#f5c400;--red:#c62f2f;--red-s:#fdeceb;--green:#1f8a4c;--green-s:#e6f5ec;--orange:#d9780f;--orange-s:#fdf1e1;
  --side:#101a24;--side2:#1a2734;--sidew:236px;
  --font:"Noto Sans TC","PingFang TC","Microsoft JhengHei","Heiti TC",system-ui,sans-serif;
  --mark:Arial,"Noto Sans Symbols","Segoe UI Symbol","Apple Symbols",sans-serif;
}
:root:not([data-theme="light"]){}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:var(--font);color:var(--ink);background:var(--paper);font-size:15px;line-height:1.5;-webkit-text-size-adjust:100%;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
h1,h2,h3{margin:0;line-height:1.25}
.hidden{display:none!important}
.muted{color:var(--mute)}
.sm{font-size:13px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.spacer{flex:1}
/* buttons */
.btn{border:1px solid var(--line2);background:#fff;padding:8px 14px;border-radius:6px;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:6px;min-height:38px;white-space:nowrap}
.btn:hover{border-color:var(--ink2)}
.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff}.btn.pri:hover{background:var(--blue-d)}
.btn.dng{color:var(--red);border-color:#e6b8b5}.btn.dng:hover{background:var(--red-s)}
.btn.sm{padding:4px 10px;min-height:30px;font-size:13px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.icon-btn{border:0;background:transparent;font-size:22px;line-height:1;padding:6px 10px;border-radius:6px;min-height:40px}
.icon-btn:hover{background:rgba(0,0,0,.06)}
/* login */
#login{min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr}
.login-art{background:#fff;border-right:1px solid var(--line);display:flex;align-items:center;justify-content:center;padding:32px;position:relative;overflow:hidden}
.login-art .sheet{position:relative;width:min(420px,80%)}
.login-art img{width:100%;display:block}
.login-art .cap{position:absolute;left:28px;bottom:22px;color:var(--mute);font-size:13px}
.login-form{display:flex;flex-direction:column;justify-content:center;padding:48px min(8vw,96px);gap:14px;background:var(--paper)}
.login-form h1{font-size:32px;letter-spacing:.04em}
.login-form .co{color:var(--blue);font-weight:700}
@media(max-width:820px){#login{grid-template-columns:1fr}.login-art{display:none}.login-form{padding:40px 24px}}
/* fields */
label.f{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--ink2);font-weight:600}
label.f>span.req{color:var(--red)}
.inp,select.inp,textarea.inp{border:1px solid var(--line2);background:#fff;border-radius:6px;padding:8px 10px;min-height:40px;width:100%;font-weight:400;color:var(--ink)}
.inp:focus{border-color:var(--blue);outline:2px solid var(--blue-s)}
.inp:disabled,.ro .inp{background:#f5f7f8;color:var(--ink2)}
textarea.inp{min-height:80px;resize:vertical}
.grid{display:grid;gap:12px}
.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}.g2{grid-template-columns:repeat(2,1fr)}.g6{grid-template-columns:repeat(6,1fr)}
@media(max-width:900px){.g4{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(2,1fr)}.g6{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.g3,.g6{grid-template-columns:1fr 1fr}.g2{grid-template-columns:1fr}}
.inline{display:flex;gap:6px;align-items:center}
.inline .inp{flex:1;min-width:0}
/* shell */
#app{display:flex;min-height:100vh}
#side{width:var(--sidew);background:var(--side);color:#dbe4ec;position:fixed;top:0;bottom:0;left:0;z-index:40;transition:transform .22s ease;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px)}
#app.collapsed #side{transform:translateX(-100%)}
#main{flex:1;min-width:0;margin-left:var(--sidew);transition:margin .22s ease;display:flex;flex-direction:column}
#app.collapsed #main{margin-left:0}
.brand{padding:18px 18px 14px;border-bottom:1px solid #26384a}
.brand b{display:block;font-size:17px;letter-spacing:.06em;color:#fff}
.brand small{color:#8fa3b5}
#nav{padding:10px 8px;flex:1;overflow:auto}
#nav a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;color:#c6d3de;text-decoration:none;font-weight:500;margin-bottom:2px;border-left:3px solid transparent}
#nav a:hover{background:var(--side2)}
#nav a.on{background:var(--side2);color:#fff;border-left-color:#5b8cff}
#nav a .ic{width:20px;text-align:center}
.side-foot{padding:12px 14px;border-top:1px solid #26384a;font-size:13px}
.side-foot b{color:#fff}
#top{height:54px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:0 12px;position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
#top h2{font-size:17px}
#backdrop{position:fixed;inset:0;background:rgba(10,18,26,.5);z-index:35;display:none}
@media(max-width:900px){
  #main{margin-left:0}
  #app:not(.collapsed) #backdrop{display:block}
}
#view{padding:20px;max-width:1400px;width:100%;margin:0 auto;flex:1}
@media(max-width:560px){#view{padding:12px}}
.page-h{display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.page-h h1{font-size:22px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:16px}
.panel+.panel{margin-top:14px}
.panel h3{font-size:15px;margin-bottom:12px}
.tag{display:inline-block;padding:1px 9px;border-radius:99px;font-size:12px;font-weight:600;background:#e9eef2;color:var(--ink2)}
.tag.blue{background:var(--blue-s);color:var(--blue)}.tag.green{background:var(--green-s);color:var(--green)}.tag.red{background:var(--red-s);color:var(--red)}.tag.orange{background:var(--orange-s);color:var(--orange)}.tag.amber{background:#fff4c2;color:#7a5f00}
/* plate */
.plate{display:inline-block;font-family:Arial,sans-serif;font-weight:700;letter-spacing:.08em;border:2px solid var(--ink);border-radius:5px;padding:1px 10px;background:#fff;font-size:18px;box-shadow:inset 0 0 0 2px #fff,inset 0 0 0 3px #b9c3cc}
.plate.blank{color:var(--mute);border-color:var(--line2);box-shadow:none}
/* tables */
.tbl{width:100%;border-collapse:collapse}
.tbl th,.tbl td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
.tbl th{font-size:13px;color:var(--mute);font-weight:600;background:#fafbfc;position:sticky;top:0}
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:#fff}
/* dashboard */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.stat{background:#fff;border:1px solid var(--line);border-radius:8px;padding:12px 14px;border-left:4px solid var(--blue)}
.stat b{font-size:28px;display:block;line-height:1.1}
.stat span{color:var(--mute);font-size:13px}
.stat.a{border-left-color:var(--orange)}.stat.b{border-left-color:var(--green)}.stat.c{border-left-color:var(--ink2)}
@media(max-width:700px){.stats{grid-template-columns:1fr 1fr}}
.two{display:grid;grid-template-columns:1.3fr 1fr;gap:14px}
@media(max-width:1000px){.two{grid-template-columns:1fr}}
.list-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.list-item:last-child{border-bottom:0}
/* dispatch */
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line2);background:#fff;border-radius:99px;padding:5px 13px;font-size:14px;min-height:34px}
.chip.on{background:var(--blue);color:#fff;border-color:var(--blue)}
.chip small{opacity:.75;margin-left:4px}
/* records */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:1100px){.cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.cards{grid-template-columns:1fr}}
.rec{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:8px}
.rec .car{font-size:16px;font-weight:700}
.rec .grades{display:flex;gap:14px;font-size:14px}
.rec .grades b{font-size:20px;color:var(--blue);margin-left:2px}
.rec .acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;padding-top:10px;border-top:1px dashed var(--line2)}
.search{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
@media(max-width:900px){.search{grid-template-columns:repeat(2,1fr)}}
/* tabs */
.tabs{display:flex;gap:0;overflow-x:auto;border-bottom:2px solid var(--line);margin-bottom:14px;scrollbar-width:none;position:sticky;top:calc(54px + env(safe-area-inset-top,0px));background:var(--paper);z-index:10;-webkit-overflow-scrolling:touch}
.tabs::-webkit-scrollbar{display:none}
.tabs button{border:0;background:transparent;padding:11px 18px;font-weight:600;color:var(--mute);white-space:nowrap;border-bottom:3px solid transparent;margin-bottom:-2px;flex:0 0 auto}
.tabs button.on{color:var(--blue);border-bottom-color:var(--blue)}
.formbar{position:sticky;bottom:0;background:rgba(242,244,246,.96);border-top:1px solid var(--line);padding:10px 0;margin-top:16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;z-index:9}
.head-info{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
/* checks */
.ck{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);background:#fff;border-radius:6px;min-height:42px;cursor:pointer;user-select:none}
.ck input{width:18px;height:18px;accent-color:var(--blue);flex:none}
.ck.on{border-color:var(--blue);background:var(--blue-s)}
.ck .extra{width:90px;flex:none;margin-left:auto;padding:3px 6px;min-height:30px}
.ck.wide{grid-column:span 2}
.phr{display:flex;flex-wrap:wrap;gap:8px}
.phr .chip{border-radius:6px}
.phr .chip.custom{border-style:dashed}
.notes-box{border:1px solid var(--line2);border-radius:6px;background:#fff;padding:10px 14px;min-height:60px}
.notes-box p{margin:2px 0}
/* body diagrams */
.diagrams{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:900px){.diagrams{grid-template-columns:1fr}}
.dg h3{text-align:center;letter-spacing:.3em;margin-bottom:6px}
.mk-wrap{position:relative;background:#fff;border:1px solid var(--line);border-radius:6px;touch-action:pan-y;user-select:none;-webkit-user-select:none;overflow:hidden}
.mk-wrap.armed{cursor:crosshair;touch-action:none}
.mk-wrap img{display:block;width:100%;height:auto;pointer-events:none}
.mk{position:absolute;transform:translate(-50%,-50%);font-family:var(--mark);font-weight:700;color:#1a47d1;white-space:nowrap;line-height:1;padding:6px 6px;cursor:grab;touch-action:none;font-size:calc(var(--sz,26)*var(--k,1)*1px)}
.mk.lock{cursor:default}
.mk.sel{outline:2px dashed var(--blue);outline-offset:0;border-radius:6px;background:rgba(23,70,201,.07)}
.mk.slot{width:calc(30px*var(--k,1));height:calc(30px*var(--k,1));min-width:22px;min-height:22px;border:1.5px dashed rgba(23,70,201,.55);border-radius:50%;padding:0;background:rgba(255,255,255,.55)}
.mk.slot.sel{border-style:solid}
.mk .t{display:inline-block}
.mk .t.x-y{background:#ffe100;padding:0 .18em}
.mk-tools{margin:8px 0}
.pal{display:flex;flex-wrap:wrap;gap:6px}
.pal button{min-width:44px;height:44px;border:1px solid var(--line2);background:#fff;border-radius:6px;font-family:var(--mark);font-weight:700;color:#1a47d1;font-size:22px;padding:0 8px}
.pal button.on{background:var(--blue);color:#fff;border-color:var(--blue)}
.pal button.cnt{border-color:#7ea0f5}
.pal button.tool{font-family:var(--font);font-size:14px;color:var(--ink);font-weight:600}
.pal button.tool.on{color:#fff}
.hint{background:var(--blue-s);color:var(--blue-d);border-radius:6px;padding:8px 12px;font-size:14px;margin:8px 0}
.selbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#fff;border:1px solid var(--line2);border-radius:6px;padding:8px 10px;margin:8px 0}
.summary-row{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-top:12px;padding:10px 14px;background:#fff;border:1px solid var(--line);border-radius:8px}
.big-num{font-size:26px;font-weight:700;color:var(--blue)}
/* photos */
.ph-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.ph{position:relative;background:#e9eef2;border-radius:6px;overflow:hidden;aspect-ratio:4/3;cursor:pointer;border:2px solid transparent}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.ph .n{position:absolute;left:4px;top:4px;background:rgba(0,0,0,.6);color:#fff;font-size:11px;border-radius:4px;padding:0 6px}
.ph .c{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(0,0,0,.65));color:#fff;font-size:11px;padding:10px 6px 3px}
.ph.drop{border-color:var(--blue)}
.overlay{position:fixed;inset:0;background:rgba(8,14,20,.92);z-index:80;display:flex;flex-direction:column;color:#fff;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.overlay .bar{display:flex;gap:8px;padding:10px;align-items:center;flex-wrap:wrap}
.overlay .bar .btn{background:#1d2a37;border-color:#39495a;color:#fff}
.overlay .bar .btn.pri{background:var(--blue);border-color:var(--blue)}
.overlay .bar .btn.dng{color:#ff9d97}
.overlay .bar select{background:#1d2a37;color:#fff;border:1px solid #39495a;border-radius:6px;padding:6px;min-height:38px}
.stage{flex:1;min-height:0;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;touch-action:none}
.stage img,.stage video{max-width:100%;max-height:100%;object-fit:contain;transition:transform .12s}
.stage video{width:100%;height:100%}
.nav-arrow{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.45);border:0;color:#fff;font-size:30px;width:46px;height:70px;border-radius:8px}
.nav-arrow.l{left:6px}.nav-arrow.r{right:6px}
.shutter{width:76px;height:76px;border-radius:50%;background:#fff;border:6px solid #9fb4c8;flex:none}
.shutter:active{transform:scale(.92)}
.cam-foot{display:flex;align-items:center;justify-content:center;gap:24px;padding:14px}
.flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
.flash.go{animation:fl .25s}
@keyframes fl{0%{opacity:.85}100%{opacity:0}}
/* modal & toast */
.modal-bg{position:fixed;inset:0;background:rgba(10,18,26,.55);z-index:70;display:flex;align-items:center;justify-content:center;padding:16px}
.modal{background:#fff;border-radius:10px;width:min(560px,100%);max-height:92vh;overflow:auto;padding:20px}
.modal.lg{width:min(860px,100%)}
.modal h3{font-size:18px;margin-bottom:14px}
.modal .foot{display:flex;gap:8px;justify-content:flex-end;margin-top:18px;flex-wrap:wrap}
#toasts{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:99;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{background:var(--ink);color:#fff;padding:10px 16px;border-radius:8px;font-size:14px;box-shadow:0 4px 14px rgba(0,0,0,.25);max-width:90vw}
.toast.err{background:var(--red)}
.perm-g{border:1px solid var(--line);border-radius:6px;padding:10px 12px;margin-bottom:10px}
.perm-g h4{margin:0 0 8px;font-size:14px}
.perm-g .grid{grid-template-columns:repeat(3,1fr)}
@media(max-width:560px){.perm-g .grid{grid-template-columns:1fr 1fr}}
.split{display:grid;grid-template-columns:300px 1fr;gap:14px;align-items:start}
@media(max-width:900px){.split{grid-template-columns:1fr}}
.sel-list button{display:flex;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);background:transparent;padding:9px 10px;align-items:center;gap:8px}
.sel-list button.on{background:var(--blue-s);font-weight:700}
.sel-list button.off{opacity:.5}
.empty{text-align:center;color:var(--mute);padding:36px 12px;border:1px dashed var(--line2);border-radius:8px;background:#fff}
/* PDF preview */
.pdf-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.pdf-stage{background:#aab4bd;padding:16px;border-radius:8px;overflow:auto}
.pdf-scale{transform-origin:top left}
.pdf-page{width:210mm;height:297mm;background:#fff;margin:0 auto 14px;padding:10mm 11mm 12mm;position:relative;overflow:hidden;color:#000;font-family:var(--pf,var(--font));font-size:calc(var(--pfs,11)*1px);line-height:1.35;box-shadow:0 2px 10px rgba(0,0,0,.25)}
.pg-in{height:260mm;overflow:hidden;position:relative}
.pg-c{width:100%}
.p-cell b{font-weight:700}
.pdf-page .foot{position:absolute;left:11mm;right:11mm;bottom:5mm;display:flex;justify-content:space-between;font-size:10px;color:#555;border-top:1px solid #999;padding-top:3px}
.p-title{text-align:center;font-size:22px;font-weight:700;letter-spacing:.5em;margin:0 0 6px}
.p-head{display:flex;align-items:center;gap:10px;margin-bottom:4px;min-height:28px}
.p-head img{max-height:34px;max-width:110px}
.p-head .cn{font-weight:700;font-size:14px}
.p-hdrtxt{font-size:10px;color:#444;margin-left:auto}
.p-box{border:1.5px solid #000;margin-bottom:4px}
.p-box{overflow:hidden}
.p-basic{display:grid;grid-template-columns:1fr 1fr 1fr 1.05fr}
.p-cell{border-right:1px solid #000;border-bottom:1px solid #000;padding:3px 6px;min-height:36px;margin:0 -1px -1px 0}
.p-cell small{display:block;font-size:10px;color:#333}
.p-cell b{font-size:15px}
.p-rate{text-align:center;padding:3px}
.p-rate .big{font-size:calc(var(--rs,28)*1px);font-weight:700;line-height:1.15}
.p-rate .lb{letter-spacing:.3em;font-weight:700;font-size:12px;border-bottom:1px solid #000;margin-bottom:2px}
.p-sec{border:1.5px solid #000;margin-bottom:4px;padding:4px 6px}
.p-sec h4{margin:0 0 3px;font-size:13px;letter-spacing:.2em}
.p-list{display:grid;grid-template-columns:repeat(4,1fr);gap:1px 6px;font-size:11px}
.p-list span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.p-notes{columns:2;column-gap:14px;font-size:12px}
.p-notes p{margin:0 0 1px;break-inside:avoid}
.p-diag{display:grid;grid-template-columns:1fr 1fr;gap:8mm;margin-top:2px}
.p-diag h4{text-align:center;letter-spacing:.4em;margin:0 0 2px;font-size:12px}
.p-mkw{position:relative}
.p-mkw img{display:block;width:100%}
.p-mkw .mk{cursor:default;padding:0}
.p-sum{display:flex;gap:24px;align-items:center;justify-content:space-between;font-size:14px;margin-top:5px;padding:2px 6px;border-top:1.5px solid #000}
.p-photo-h{background:#eef1f4;padding:2px 8px;font-weight:700;font-size:12px;margin:6px 0 3px;border-left:4px solid #333;break-inside:avoid}
.p-photos{display:grid;gap:4mm}
.p-ph{border:1px solid #888;position:relative;overflow:hidden;background:#f6f7f8}
.p-ph img{display:block;width:100%;height:100%;object-fit:cover}
.p-ph.none{display:flex;align-items:center;justify-content:center;color:#666;font-size:14px}
.p-int{font-size:10px;color:#333}
.p-int p{margin:0}
@media print{
  @page{size:A4;margin:0}
  html,body{background:#fff!important;height:auto}
  body>*:not(#printRoot){display:none!important}
  #printRoot{display:block!important}
  #printRoot .pdf-page{margin:0;box-shadow:none;page-break-after:always;break-after:page}
  #printRoot .pdf-page:last-child{page-break-after:auto;break-after:auto}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
#printRoot{display:none}
